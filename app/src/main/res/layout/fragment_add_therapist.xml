<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:background="@color/clinicScreenBackground" android:fitsSystemWindows="true">
        <TextView
            style="@style/ErrorBanner"
            android:id="@+id/errorTextView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            android:includeFontPadding="false"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginStart="16dp" android:layout_marginTop="18dp" android:layout_marginEnd="16dp"
            app:cardBackgroundColor="@color/clinicCardBackground" app:cardCornerRadius="@dimen/card_corner_radius" app:cardElevation="12dp"
            app:strokeColor="@android:color/transparent" app:strokeWidth="0dp"
            app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/errorTextView">
            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/therapistEmailLayout" style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Therapist Email">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/therapistEmailEditText" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:inputType="textEmailAddress" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/addTherapistButton" android:layout_width="match_parent" android:layout_height="48dp"
                    android:layout_marginTop="16dp" android:background="@drawable/bg_primary_button" android:paddingHorizontal="20dp"
                    android:text="Add Therapist" android:textColor="@android:color/white" android:textStyle="bold"
                    app:backgroundTint="@null" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <include
            android:id="@+id/loadingViewInclude" layout="@layout/view_loading" android:layout_width="match_parent" android:layout_height="match_parent"
            app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
