<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/emptyStateView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_empty_state_card"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="28dp"
    android:paddingTop="44dp"
    android:paddingEnd="28dp"
    android:paddingBottom="44dp"
    android:visibility="gone"
    tools:visibility="visible">

    <FrameLayout
        android:layout_width="92dp"
        android:layout_height="92dp"
        android:background="@drawable/bg_empty_state_icon"
        android:elevation="5dp">

        <ImageView
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_empty_state" />

    </FrameLayout>

    <TextView
        android:id="@+id/emptyTitleTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:gravity="center"
        android:textColor="#142033"
        android:textSize="20sp"
        android:textStyle="bold"
        tools:text="No clinics yet" />

    <TextView
        android:id="@+id/emptyMessageTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:lineSpacingExtra="3dp"
        android:textColor="#60708D"
        android:textSize="15sp"
        tools:text="Once the Coordinator will add you to a clinic it will appear here." />
</LinearLayout>
