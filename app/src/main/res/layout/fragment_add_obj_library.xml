<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/slateIndigo">

        <View
            android:id="@+id/formBackground"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/bg_objective_library_list"
            app:layout_constraintTop_toBottomOf="@id/levelSubtitleBand"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Success Message View -->
        <LinearLayout
            android:id="@+id/successMessageView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@color/green"
            android:orientation="horizontal"
            android:padding="20dp"
            android:gravity="center"
            android:elevation="8dp"
            android:visibility="gone"
            android:translationY="-100dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/successMessageText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                android:drawablePadding="12dp"
                android:gravity="center_vertical"
                app:drawableStartCompat="@drawable/ic_thumb_up"
                app:drawableTint="@android:color/white" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/levelSubtitleBand"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_subtitle_band"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:paddingTop="9dp"
            android:paddingBottom="11dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/levelLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="Level:"
                android:textColor="@color/toolbarTextMuted"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/selectedLevelTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:includeFontPadding="false"
                android:text="Beginner"
                android:textColor="@color/objectiveLevelBeginner"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/objectiveTypeInputLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:layout_goneMarginTop="20dp"
            android:layout_marginHorizontal="20dp"
            android:hint="Objective Type"
            style="@style/LibraryFormDropdown"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/formErrorTextView">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/objectiveTypeTextView"
                style="@style/LibraryFormFieldContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@android:color/white"
                android:popupBackground="@color/clinicCardBackground"
                android:inputType="none" />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/objectiveNameInputLayout"
            style="@style/LibraryFormInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginHorizontal="20dp"
            android:hint="Objective Name"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/objectiveTypeInputLayout">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/objectiveNameEditText"
                style="@style/LibraryFormFieldContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@android:color/white"
                android:inputType="text|textCapSentences" />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/createObjectiveButton"
            android:textColor="@color/slateIndigo"
            app:backgroundTint="@android:color/white"
            app:cornerRadius="@dimen/card_corner_radius"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginHorizontal="20dp"
            android:text="Create Objective"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/objectiveNameInputLayout" />

        <TextView
            style="@style/ErrorBanner"
            android:id="@+id/formErrorTextView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginHorizontal="20dp"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/levelSubtitleBand" />

        <!--Loading view-->
        <include
            android:id="@+id/loadingViewInclude"
            layout="@layout/view_library_loading"
            android:layout_height="match_parent"
            android:layout_width="match_parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>