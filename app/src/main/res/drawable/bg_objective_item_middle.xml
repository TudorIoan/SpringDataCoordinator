<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Hide the joining edges so expanded rows share one outer border. -->
    <item android:top="-1dp" android:bottom="-1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/objectiveGroupItemBackground" />
            <stroke android:width="1dp" android:color="@color/objectiveGroupBorder" />
        </shape>
    </item>
</layer-list>
